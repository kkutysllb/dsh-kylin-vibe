    {
      "id": "order",
      "zh": "订单服务",
      "en": "OrderService",
      "duty": "管理订单生命周期与状态流转，是交易链路的编排中枢",
      "topics": [
        "订单状态机",
        "超时与自动取消",
        "幂等提交",
        "订单拆单",
        "逆向流程"
      ]
    },
    {
      "id": "inventory",
      "zh": "库存服务",
      "en": "InventoryService",
      "duty": "负责库存扣减、回补、对账与补货",
      "topics": [
        "库存扣减",
        "防超卖",
        "库存对账",
        "补货",
        "库存快照"
      ]
    },
    {
      "id": "payment",
      "zh": "支付服务",
      "en": "PaymentService",
      "duty": "对接支付渠道，管理资金流水与退款",
      "topics": [
        "渠道适配",
        "支付回调",
        "资金对账",
        "风控接入",
        "退款"
      ]
    },
    {
      "id": "user",
      "zh": "用户服务",
      "en": "UserService",
      "duty": "管理账户、会员等级与实名信息",
      "topics": [
        "账户体系",
        "会员等级",
        "实名认证",
        "人群圈选",
        "隐私与合规"
      ]
    },
    {
      "id": "notification",
      "zh": "通知服务",
      "en": "NotificationService",
