      "topics": [
        "通道管理",
        "模板管理",
        "投递可靠性",
        "订阅偏好"
      ]
    },
    {
      "id": "search",
      "zh": "搜索服务",
      "en": "SearchService",
      "duty": "提供商品检索、筛选与排序",
      "topics": [
        "索引构建",
        "索引分片",
        "查询语法",
        "无货过滤"
      ]
    },
    {
      "id": "cart",
      "zh": "购物车服务",
      "en": "CartService",
