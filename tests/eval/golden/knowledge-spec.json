      "topics": [
        "合并策略",
        "结算前快照",
        "优惠试算",
        "失效清理"
      ]
    },
    {
      "id": "promotion",
      "zh": "促销服务",
      "en": "PromotionService",
      "duty": "管理券、满减与活动规则",
      "topics": [
        "券体系",
        "满减规则",
        "活动管理",
        "预算控制"
      ]
    },
    {
      "id": "logistics",
      "zh": "物流服务",
      "en": "LogisticsService",
      "duty": "管理发货单、轨迹与签收",
      "topics": [
        "发货单",
        "轨迹订阅",
        "签收确认",
        "逆向物流"
      ]
    },
    {
      "id": "risk",
